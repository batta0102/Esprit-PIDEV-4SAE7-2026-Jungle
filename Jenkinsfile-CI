// Jenkinsfile-CI — microservice GestionCours (Spring Boot)
// Job Jenkins : Pipeline from SCM → Script Path = Jenkinsfile-CI
//
// Étapes : checkout → vérification JDK/Maven → package Maven (tests ignorés : -DskipTests, le temps de stabiliser les tests Spring)

pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '15'))
    }

    environment {
        MICROSERVICE_NAME = 'GestionCours'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Tools') {
            steps {
                sh 'java -version'
                sh 'mvn -version'
            }
        }

        stage('Maven — build (skip tests)') {
            steps {
                sh 'mvn -B -ntp clean package -DskipTests'
            }
        }
    }

    post {
        success {
            archiveArtifacts artifacts: 'target/*.jar', fingerprint: true, allowEmptyArchive: false
        }
    }
}
